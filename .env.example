# Database Configuration
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
# For local development with docker-compose: postgresql://postgres:postgres@localhost:5432/linguastorymate
DATABASE_URL=postgresql://username:password@host:port/database

# OpenAI API Configuration
# Required for story generation, image generation, audio, and quizzes
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Session Configuration
# Secret key for signing session cookies
# Generate a strong random string: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# Server Configuration
# Port the server will listen on (default: 5000)
PORT=5000

# Node Environment (development or production)
NODE_ENV=development

# Email Configuration (Optional - Required for password reset functionality)
# Gmail address for sending password reset emails
EMAIL_USER=your_email@gmail.com

# Gmail app password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_app_password_here

# Application URL
# Full URL where your application is hosted (required for password reset links)
# For local development: http://localhost:5000
# For production: https://your-domain.com
APP_URL=http://localhost:5000
